<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/srcedit_header"
        style="@style/Nullroute.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/Nullroute.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/srcedit_header_note" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/srcedit_url_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/srcedit_add_url">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/srcedit_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Block vs allow is a property of how WE consume the list, not of the
         list contents, so it has to be chosen here. HaGeZi ships the same 1,604
         domains as both a blocklist and an allowlist; nothing in the file says
         which one it is. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/srcedit_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/srcedit_role_block"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/srcedit_role_block" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/srcedit_role_allow"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/srcedit_role_allow" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/Nullroute.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/srcedit_role_note" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/srcedit_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/srcedit_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/srcedit_reset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/srcedit_reset" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/srcedit_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        style="@style/Nullroute.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/srcedit_footer" />
</LinearLayout>

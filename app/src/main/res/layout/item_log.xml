<?xml version="1.0" encoding="utf-8"?>
<!--
    One log row, shared by the Apps, Domains and Recent views.

    The name is the only part that can be long, so it is the only part that gets
    the weight; the badge (a verdict or a relative time) keeps its intrinsic width
    so it never gets ellipsised down to nothing on a narrow screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/log_row_title"
            style="@style/Nullroute.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:maxLines="1" />

        <TextView
            android:id="@+id/log_row_subtitle"
            style="@style/Nullroute.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/log_row_badge"
        style="@style/Nullroute.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1" />

</LinearLayout>

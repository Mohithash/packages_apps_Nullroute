<?xml version="1.0" encoding="utf-8"?>
<!--
    Tile preferences. Reached from Settings, and from the shade's own
    "tile preferences" affordance via the QS_TILE_PREFERENCES intent filter.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Nullroute.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qsp_action_header" />

        <RadioGroup
            android:id="@+id/qsp_action_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/qsp_action_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qsp_action_toggle" />

            <TextView
                style="@style/Nullroute.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/qsp_action_toggle_detail" />

            <RadioButton
                android:id="@+id/qsp_action_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qsp_action_open" />

            <TextView
                style="@style/Nullroute.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/qsp_action_open_detail" />
        </RadioGroup>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/qsp_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/qsp_confirm" />

        <TextView
            android:id="@+id/qsp_confirm_detail"
            style="@style/Nullroute.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qsp_confirm_detail" />

        <TextView
            style="@style/Nullroute.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/qsp_state_note" />

    </LinearLayout>
</ScrollView>

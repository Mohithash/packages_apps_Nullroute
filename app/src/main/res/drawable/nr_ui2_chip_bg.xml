<?xml version="1.0" encoding="utf-8"?>
<!--
    The risk chip background. A shape rather than a Material Chip: the chip here
    is never tappable and never selectable, and a widget that looks tappable and
    is not is its own small lie. Tinted per row from code.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
